{
  "name": "shoresh",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "main": "electron/main.js",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "pretest": "node scripts/ensure-abi.js node",
    "test": "vitest run",
    "pretest:integration": "node scripts/ensure-abi.js node",
    "test:integration": "node test/integration/run.automerge.js",
    "preelectron:dev": "node scripts/ensure-abi.js electron",
    "preelectron:build": "node scripts/ensure-abi.js electron",
    "electron:dev": "concurrently -k \"vite\" \"cross-env VITE_DEV_SERVER_URL=http://localhost:5200 electron electron/main.js\"",
    "electron:dev:fresh": "pkill -x Electron; sleep 1 && npm run electron:dev",
    "electron:build": "node scripts/write-build-info.js && vite build && electron-builder",
    "unlock-key": "electron electron/unlockDbKey.js",
    "install:mac": "bash scripts/install-macos.sh",
    "deploy:local": "bash scripts/deploy-local.sh",
    "premcp": "node scripts/ensure-abi.js node",
    "mcp": "node scripts/mcp/server.js",
    "ingest:sweep": "node scripts/ingest-sweep.mjs",
    "index:work": "node scripts/build-work-index.js",
    "check:governance": "node scripts/check-governance.js",
    "agents:check": "node scripts/generateAgentProfiles.js",
    "agents:generate": "node scripts/generateAgentProfiles.js --write",
    "gate:shadow-check": "node scripts/shadowGateEnvelope.js",
    "verify": "node scripts/verify.js",
    "security": "node scripts/security-gate.js",
    "gate": "zsh scripts/gate.sh"
  },
  "dependencies": {
    "@automerge/automerge": "^3.4.1",
    "@chainsafe/libp2p-noise": "^17.0.0",
    "@chainsafe/libp2p-yamux": "^8.0.1",
    "@dnd-kit/core": "^6.3.1",
    "@libp2p/identify": "^4.1.14",
    "@libp2p/mdns": "^12.0.32",
    "@libp2p/tcp": "^11.0.28",
    "@multiformats/multiaddr": "^13.0.3",
    "better-sqlite3": "^12.11.1",
    "bonjour-service": "^1.4.3",
    "it-length-prefixed": "^9.1.1",
    "it-pipe": "^3.0.1",
    "libp2p": "^3.3.11",
    "phaser": "^3.90.0",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "ws": "^8.21.1",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz"
  },
  "optionalDependencies": {
    "better-sqlite3-multiple-ciphers": "12.11.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "acorn": "^8.16.0",
    "concurrently": "^10.0.3",
    "cross-env": "^10.1.0",
    "electron": "^43.1.1",
    "electron-builder": "^26.15.3",
    "eslint": "^9.39.4",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.5.0",
    "jsdom": "^29.1.1",
    "pngjs": "^7.0.0",
    "vite": "^8.0.9",
    "vitest": "^4.1.7"
  },
  "build": {
    "appId": "com.shoresh.scheduling",
    "productName": "Shoresh",
    "files": [
      "electron/**/*",
      "dist/**/*",
      "src/**/*",
      "package.json"
    ],
    "asar": false,
    "directories": {
      "output": "release"
    },
    "icon": "build/icon.png",
    "mac": {
      "target": "dir",
      "category": "public.app-category.productivity",
      "identity": null,
      "icon": "build/icon.icns"
    },
    "win": {
      "target": "nsis"
    },
    "nsis": {
      "perMachine": false,
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  }
}
